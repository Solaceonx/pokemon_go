# built or regenerated locally
bin/
__pycache__/
*.pyc
.DS_Store
captures/
# large training examples and positions; scripts regenerate them
runs/*/examples.npz
runs/engine_habits.json
runs/distill/labels_*.npz
data/value_positions.npz
runs/teams_first_pass.json
# the screen reader: a copy of its Python environment and a checkout of its branch (see scripts/recording/README.md)
.reader/
# VOD originals, playable clips, temporary normalization and scan caches
.vod/
*.mp4
*.MP4
*.part
*.incomplete*
# engine_versus.py checkpoints hold every battle and every search time (megabytes); the printed summaries
# and exact commands are kept as small .out files under runs/.
runs/engine_versus/*.json
# Self-play positions from selfplay_eval.py (its command makes them again).
runs/selfplay/*/positions_*.npz
# the website store URL and read key (scripts/pvpbot_store)
.pvpbot_store.json
runs/bait_rates.json
